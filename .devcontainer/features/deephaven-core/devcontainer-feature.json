{
  "id": "deephaven-core",
  "version": "1.0.0",
  "name": "Deephaven Core Feature Bundle",
  "postAttachCommand": "/usr/local/share/deephaven-core-post-attach.sh",
  "dependsOn": {
    "ghcr.io/devcontainers/features/git-lfs:1": {
      "autoPull": false
    },
    "ghcr.io/devcontainers/features/java:1": {
      "installGradle": true,
      "version": "21",
      // 17 & 25 Used for certain CI tests. TBD whether we need in devcontainer
      // "additionalVersions": "17,25",
      "jdkDistro": "tem",
      "gradleVersion": "latest",
      "mavenVersion": "latest",
      "antVersion": "latest",
      "groovyVersion": "latest"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "nodeGypDependencies": true,
      "version": "latest",
      "pnpmVersion": "none",
      "nvmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "installTools": true,
      "version": "3.12"
    }
  }
}
