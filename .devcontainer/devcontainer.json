{
  "name": "Default",
  "image": "mcr.microsoft.com/devcontainers/base:noble",
  "features": {
    "./features/deephaven-core": {},
    "ghcr.io/devc-tools/features/agents:0": {
      "installClaudeCli": true,
      "installCopilotCli": true,
      "installHerdr": true,
      "installPiCli": true,
      "piPackages": "npm:@andrewjacop/pi-herdr"
    },
    "ghcr.io/devc-tools/features/node-nvmrc:0": {
      "projectDir": "web/client-api/types"
    }
  },
  "remoteEnv": {
    "LANG": "en_US.utf8",
    "PROJECT_PATH": "${containerWorkspaceFolder}",
    // This can be provided by host $TZ or defaults to America/New_York if not sets
    "TZ": "${localEnv:TZ:America/New_York}",
    "DEEPHAVEN_CORE_SKIP_DOCKER_IMAGE_CHECK": "1"
  },
  "initializeCommand": "bash \"${localWorkspaceFolder}/.devcontainer/initialize-command.sh\"",
  "mounts": [
    // ~/.claude folder
    "type=volume,source=claude-code-config-${localWorkspaceFolderBasename},target=/home/vscode/.claude",

    // Host ~/.claude config seed, onto the agents Feature's fixed seed path. The Feature's
    // own post-create.sh symlinks every top-level *file* from here into ~/.claude, and folds
    // ~/.claude.json into the same volume, so there is no second
    // volume to mount for it.
    "type=bind,source=${localEnv:HOME}/.config/devc/.claude,target=/usr/local/share/devc-features/agents/claude-seed,consistency=cached,readonly",

    // Git identity extracted from the host by initialize-command.sh, onto the
    // git-container-config Feature's fixed identity path. Read-only, and deliberately not the
    // host's ~/.gitconfig — see that script for why.
    "type=bind,source=${localEnv:HOME}/.config/devc/gitconfig-identity,target=/usr/local/share/devc-features/git-container-config/identity/gitconfig,consistency=cached,readonly",

    "type=volume,source=node-modules-${localWorkspaceFolderBasename},target=${containerWorkspaceFolder}/web/client-api/types/node_modules"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "claudeCode.allowDangerouslySkipPermissions": true,
        "claudeCode.initialPermissionMode": "bypassPermissions",
        "chat.agent.maxRequests": 50,
        "chat.tools.terminal.autoApprove": { "/.*/": true },
        "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
        "editor.formatOnSave": true,
        "terminal.integrated.defaultProfile.linux": "bash",
        "workbench.colorCustomizations": {
          "statusBar.background": "#7c3aed",
          "statusBar.foreground": "#ffffff",
          "titleBar.activeBackground": "#7c3aed",
          "titleBar.activeForeground": "#ffffff",
          "titleBar.inactiveBackground": "#5b21b6",
          "titleBar.inactiveForeground": "#ffffff",
          "chat.requestBorder": "#e21010",
          "statusBarItem.remoteBackground": "#e21010"
        }
      }
    }
  }
}
